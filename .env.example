# NeuroScan AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Paths
NEUROSCAN_DATA_DIR=data/raw/brain_tumor_mri
NEUROSCAN_CHECKPOINTS_DIR=checkpoints
NEUROSCAN_REPORTS_DIR=reports
NEUROSCAN_CONFIG=configs/dataset_config.yaml

# Hardware & Compute
NEUROSCAN_DEVICE=auto
NEUROSCAN_SEED=42
NEUROSCAN_NUM_WORKERS=2

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
LOG_LEVEL=INFO
