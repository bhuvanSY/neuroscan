# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Large datasets & raw files (preserve folder structure with .gitkeep)
data/archive/*
!data/archive/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Frontend build and dependencies
frontend/node_modules/
frontend/dist/
node_modules/

# Checkpoints and trained model weights (files > 100MB rejected by GitHub)
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.ckpt
checkpoints/*.bin
!checkpoints/.gitkeep
models/*.pt
models/*.pth
models/*.onnx
!models/.gitkeep

# Large analysis dumps
reports/duplicate_analysis.json

# Logs and system caches
*.log
.system_generated/

# OS generated files
.DS_Store
Thumbs.db
